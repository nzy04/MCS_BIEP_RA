    "@tiptap/starter-kit": "2.27.2",
    "@tiptap/vue-3": "2.27.2",
    "dompurify": "^3.2.7",
    "fflate": "0.8.2",
    "lucide-vue-next": "^0.468.0",
    "mammoth": "^1.10.0",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "^5.4.296",
