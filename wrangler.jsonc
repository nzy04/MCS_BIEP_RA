{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcs-biep-ra",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "secrets": {
    "required": ["GITHUB_CLIENT_SECRET", "SESSION_SECRET"],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "SITE_TITLE": "MCS_BIEP",
    "GITHUB_OWNER": "nzy04",
    "GITHUB_REPO": "MCS_BIEP_RA",
    "GITHUB_BRANCH": "main",
    "GITHUB_CLIENT_ID": "Iv23liUekDd6CZVIiGPn",
  },
}
