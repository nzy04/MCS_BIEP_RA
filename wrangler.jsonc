{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcs-biep-ra",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "durable_objects": {
    "bindings": [
      { "name": "REVIEW_QUEUE", "class_name": "ReviewQueue" },
      { "name": "MEMBERS", "class_name": "MemberRegistry" },
    ],
  },
  "migrations": [
    { "tag": "review-v1", "new_sqlite_classes": ["ReviewQueue"] },
    { "tag": "members-v1", "new_sqlite_classes": ["MemberRegistry"] },
  ],
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "SESSION_SECRET",
      "GITHUB_APP_PRIVATE_KEY",
    ],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "SITE_TITLE": "MCS_BIEP",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "REVIEW_DAILY_LIMIT": "50",
    "REVIEW_USER_DAILY_LIMIT": "10",
    "GITHUB_BRANCH": "main",
  },
}
