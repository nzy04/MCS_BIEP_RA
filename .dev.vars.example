# Copy to .dev.vars for local development. Keep credentials out of version control.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
DEEPSEEK_API_KEY=
# GitHub App private key, stored as a secret in production; never commit a real key.
GITHUB_APP_PRIVATE_KEY=
